@model WebApplication2.Models.ViewModels.EditPostViewModel


@{
	ViewData["Title"] = "Edit Post";
}
<style>
	.content-wrapper {
		padding: 20px;
		max-width: 1000px;
		margin: 0auto;
		font-family: sans-serif;
	}

</style>

<div class="content-wrapper">
	
	<div class="row">
		<div class="col-6">
			<h2>@ViewData["Title"]</h2>
		</div>
		<div class="col-6 text-end mt-2 ">
			<a class="btn btn-primary " asp-action="Index" asp-controller="Post">Back to List</a>

		</div>

	</div>

	<hr />

	<form asp-action="Edit" asp-controller="Post" method="Post" enctype="multipart/form-data">

		<div class="validation-summary">
			<div asp-validation-summary="All" class=" text-danger"></div>
		
		</div>
		<input asp-for="Post.Id" hidden />
		<div class="form-group">
			<label asp-for="Post.Title"></label>
			<input type="text" asp-for="Post.Title" class="form-control" />
			<span asp-validation-for="Post.Title"></span>
		</div>

		<div class="form-group mt-2">
			<label asp-for="Post.CategoryId"></label>
			<select asp-for="Post.CategoryId" asp-items="Model.Categories" class="form-control">

				<option value="">Select Category</option>/>

			</select>
			<span asp-validation-for="Post.Title"></span>
		</div>


		<div class="form-group mt-2">
			<label asp-for="Post.Author"></label>
			<input type="text" asp-for="Post.Author" class="form-control" />
			<span asp-validation-for="Post.Author" class="text-danger"></span>
		</div>

		<div class="form-group mt-2">
			<label asp-for="Post.Content"></label>
			<textarea type="text" asp-for="Post.Content" rows="5" class="form-control"></textarea>
			
			<span asp-validation-for="Post.Author" class="text-danger"></span>
		</div>

		<div class=" form-group mt-2">
			<label asp-for="FeatureImage"></label>
			<input asp-for="FeatureImage" class="form-control" />

		</div>
		<div class="col-6  mt-2 ">
			<button type="submit" class="btn btn-primary ">Update</button>
			<a class="btn btn-secondary  ">Back to List</a>
		</div>


		
	</form>



</div>
